# ============================================
# Dookhtak website — Apache configuration
# ============================================

# ---- Security headers ----
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Default charset ----
AddDefaultCharset UTF-8

# ---- Custom error document (also runs the redirect middleware) ----
ErrorDocument 404 /404.php

# ---- Compression ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ---- Caching policy ----
<IfModule mod_expires.c>
    ExpiresActive On
    # Fingerprint-free static assets: cache hard for a year (bump filenames on change).
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    # HTML is dynamic — never cache at the CDN/browser layer.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
    # Long-lived, immutable static files.
    <FilesMatch "\.(css|js|png|jpe?g|webp|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # HTML responses must always revalidate.
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block /includes, /database, /cache from the web entirely
    RewriteRule ^(includes|database|cache)(/|$) - [F,L]

    # ---- HTTPS redirect ----
    # Enable after the SSL certificate is installed on cPanel:
    # uncomment the two lines below (toggle).
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ---- Canonical host: non-www ----
    # dookhtak.ir is the canonical host; www redirects to it.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # ---- SEO endpoints (generated by PHP) ----
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$  robots.php  [L]

    # ---- Clean URLs ----
    # /blog/{slug} -> blog-post.php (full SSR)
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog-post.php?slug=$1 [QSA,L]

    # /features, /pricing, ... -> page.php
    RewriteRule ^features/?$  features.php  [QSA,L]
    RewriteRule ^pricing/?$   pricing.php   [QSA,L]
    RewriteRule ^tutorials/?$ tutorials.php [QSA,L]
    RewriteRule ^blog/?$      blog.php      [QSA,L]
    RewriteRule ^about/?$     about.php     [QSA,L]
    RewriteRule ^contact/?$   contact.php   [QSA,L]
</IfModule>
